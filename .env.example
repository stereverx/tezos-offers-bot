# Telegram bot token from @BotFather
# Use a NEW token - do not reuse a token from another app, two apps
# polling getUpdates on one token will steal each other's updates.
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tezos_offers

# Redis connection string (rate limiting + scan lock)
REDIS_URL=redis://localhost:6379/0

# Seconds between scan cycles (default 300 = 5 minutes)
SCAN_INTERVAL=300

# objkt public API allows 120 requests/minute
OBJKT_RATE_LIMIT_RPM=100

# Optional: log full tracebacks
DEBUG=false
