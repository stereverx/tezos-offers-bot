# Copy to .env and fill in both values before running.

# From @BotFather. Use a NEW token - do not reuse a token from another app,
# because two apps polling getUpdates on one token steal each other's updates.
TELEGRAM_BOT_TOKEN=

# Any random string; only used by the local postgres container.
# Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Seconds between scan cycles (default 300 = 5 minutes)
SCAN_INTERVAL=300

# Teia is a separate indexer and costs one query per held token, so it is
# polled on its own slower cadence. Lower SCAN_INTERVAL is fine; Teia cost
# does not grow with it.
TEIA_SCAN_INTERVAL=600

# objkt public API allows 120 requests/minute; stay under it.
OBJKT_RATE_LIMIT_RPM=100

# Local development only. Under Docker Compose the bot talks to the `db`
# service over the compose network, so DATABASE_URL is set automatically.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tezos_offers

DEBUG=false
